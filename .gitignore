# Environment and credentials
.env
*.env.local
config.yaml
credentials/
*.json.key
service-account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
*.egg

# Data (generated at runtime)
data/
*.db
*.sqlite
*.sqlite3
reports/
snapshots/
research/learnings/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.code-workspace

# Claude Code — local settings/state stay untracked, but .claude/rules/ SHIPS
# with the repo (CLAUDE.md/AGENTS.md load-on-demand pointers and
# doctor.py check_instruction_chain both require those files on a fresh clone).
.claude/*
!.claude/rules/

# Temp
/tmp/
*.tmp
*.bak

# Node / Next.js
node_modules/
.next/
.vercel/
pnpm-lock.yaml

# Rendered workspace files (generated by render_templates.py)
# Uncomment if you want to keep rendered files out of git:
# workspace/agents/*.md
# !workspace/agents/*.md.j2

# Ad platform pull data and mutation logs (contains account data / tokens)
workspace/ads/pulls/
workspace/ads/mutations/
.vercel

# context-health re-grounding runtime state
.claude/state/
