# ============================================================================
# Kai CMO Harness — Configuration
# ============================================================================
# Copy this file to config.yaml and fill in your values.
# Then run: python render_templates.py
# ============================================================================

owner:
  name: "Your Name"
  company: "Your Company"
  timezone: "America/New_York"

# Kai Runtime — canonical workspace profile for the Claude Code-style clone
# (read by kai/runtime/loader.py; sensible defaults apply if omitted)
workspace:
  id: "my-business"
  name: "My Business"
  description: "Marketing-native Claude Code-style runtime with local and remote execution."
  primary_user: "operator"
  product_mode: "clone"
  surfaces: ["local", "remote"]
  enabled_plugins:
    - "kai-marketing"

# Products you're marketing. Add as many as needed.
# Each product gets its own domain agent + analytics.
products:
  - id: myproduct
    name: "My Product"
    url: "https://myproduct.com"
    description: "One-line description of what it does"
    # Analytics keys (must match .env variable names)
    supabase_url_env: "MYPRODUCT_SUPABASE_URL"
    supabase_key_env: "MYPRODUCT_SUPABASE_KEY"
    ga4_property_env: "GA_MYPRODUCT_PROPERTY_ID"
    gsc_url_env: "GSC_MYPRODUCT_URL"
    # Discord channel for this product's alerts
    discord_channel_id: ""
    # Site-specific proof points (injected into content briefs)
    proof_points: |
      - Fact 1 about the product
      - Fact 2 with specific numbers
      - Pricing: $X/mo
    # Classification hints for the business-profile loader (optional)
    # archetype: "software"                  # software | professional-services | ...
    # archetype_overlays: ["local-service"]

# Discord channels (OpenClaw path only)
discord:
  writer_channel_id: ""      # Content approval drafts
  finance_channel_id: ""     # Revenue/subscription alerts
  updates_channel_id: ""     # Daily/weekly reports
  health_channel_id: ""      # Infrastructure alerts
  research_channel_id: ""    # Research digest
  # Per-site alert routing (read by scripts/harness_config.py)
  fallback_channel: ""       # Used when a site has no channel mapping below
  channels: {}               # Site key -> Discord channel ID
  #  myproduct: "123456789012345678"

# Harness settings
harness:
  four_us_threshold: 12          # Minimum Four U's score (12 for long-form, 10 for ads)
  max_gate_retries: 2            # Auto-revision attempts before escalating to human
  self_improvement: true         # Enable pattern extraction + harness defaults updates
  llm_provider: "gemini"         # gemini | openai | anthropic
  llm_model: "gemini-2.0-flash"  # Model for content generation

# API settings (top-level — read by scripts/harness_config.py; env vars override)
gemini_model: "gemini-2.0-flash"
api_timeout: 30       # seconds — applied to all LLM API calls
api_max_retries: 3    # circuit breaker: fail after N consecutive errors

# Paths (override with env vars: CMO_BASE_DIR, WORKSPACE_DIR, CMO_DATA_DIR, etc.)
paths:
  # cmo_base_dir: "/opt/cmo-analytics"   # uncomment on server
  # workspace_dir: "/root/.openclaw/workspace"
  # data_dir: "/opt/cmo-analytics/data"
  # marketing_md: "/root/.openclaw/workspace/MARKETING.md"
  # knowledge_base: "/root/.openclaw/workspace/knowledge/playbooks"

# Site-specific integrations — site key -> Search Console / GA4 property
# (read by scripts/harness_config.py; GA4 values can be overridden with
# GA4_PROPERTY_<SITEKEY> env vars)
sites:
  gsc_urls: {}
  #  myproduct: "sc-domain:myproduct.com"
  ga4_properties: {}
  #  myproduct: ""

# Performance and pattern thresholds (read by scripts/harness_config.py)
thresholds:
  win_position: 5       # GSC position <= N = winner
  win_ctr: 0.05         # 5% CTR minimum for winner
  win_time_on_page: 90  # seconds on page minimum for winner
  min_n: 10             # minimum data points to declare a pattern
  min_delta: 0.15       # minimum 15% lift to be actionable

# Server deployment (OpenClaw path only)
server:
  host: ""                       # VPS IP address
  user: "root"
  workspace_path: "~/.openclaw/workspace"
  analytics_path: "/opt/cmo-analytics"
  venv_python: "/opt/cmo-analytics/venv/bin/python3"

# Publishing — CMS integration for content pipeline output
publishing:
  # Master switch for auto-publish after gate + approval. Default OFF: the
  # engine logs approved content as status=approved_unpublished (url: null)
  # and a human publishes + backfills via content_log.mark_published().
  # Env override: KAI_PUBLISH_ENABLED=1/0.
  enabled: false
  # Per-site routing — a site auto-publishes only when listed here.
  # Extra keys (status, categories, tags, output_dir, ...) pass through to
  # the publisher; status defaults to "draft" so nothing goes live unseen.
  sites: {}
  #  kaicalls:
  #    platform: "wordpress"        # wordpress | ghost | webflow | markdown
  #    status: "draft"
  default_platform: "wordpress"    # wordpress | ghost | webflow | markdown
  wordpress:
    url_env: "WP_URL"
    username_env: "WP_USERNAME"
    password_env: "WP_APP_PASSWORD"  # Application Password, not login password
  ghost:
    url_env: "GHOST_URL"
    admin_key_env: "GHOST_ADMIN_KEY"
  webflow:
    api_token_env: "WEBFLOW_API_TOKEN"
    site_id_env: "WEBFLOW_SITE_ID"
    collection_id_env: "WEBFLOW_COLLECTION_ID"
  markdown:
    output_dir: "./content/blog"
    generator: "hugo"              # hugo | jekyll | astro | 11ty

# Social media — posting and scheduling
social:
  linkedin:
    access_token_env: "LINKEDIN_ACCESS_TOKEN"
    person_id_env: "LINKEDIN_PERSON_ID"  # urn:li:person:xxxxx
  twitter:
    api_key_env: "TWITTER_API_KEY"
    api_secret_env: "TWITTER_API_SECRET"
    access_token_env: "TWITTER_ACCESS_TOKEN"
    access_secret_env: "TWITTER_ACCESS_SECRET"
  buffer:
    access_token_env: "BUFFER_ACCESS_TOKEN"

# Competitors — monitored for intel reports
competitors:
  - url: "https://competitor1.com"
    name: "Competitor 1"
    rss_feed: "https://competitor1.com/blog/feed"
  - url: "https://competitor2.com"
    name: "Competitor 2"
    rss_feed: ""  # Auto-detected from common paths

# Keywords to track in SERP tracker (in addition to GSC data)
tracked_keywords:
  - "your main keyword"
  - "your second keyword"

# Scheduled tasks (OpenClaw path only)
schedule:
  daily_report: "0 8 * * *"       # 8am daily
  weekly_report: "0 8 * * 1"      # 8am Monday
  pattern_extract: "0 8 * * 1"    # 8am Monday
  performance_check: "0 9 1 * *"  # 9am 1st of month
  competitor_check: "0 6 * * *"   # 6am daily - RSS + sitemap check
  serp_track: "0 7 * * *"         # 7am daily - keyword rankings
  market_brief: "0 9 * * 1"       # 9am Monday - weekly market brief

# Netlify one-click deployment parameters
netlify:
  token: ""      # Netlify Personal Access Token
  site_id: ""    # Automatically populated after first deploy
  site_url: ""   # Automatically populated after first deploy
