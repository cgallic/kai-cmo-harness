  "profiles": [
    {
      "id": "services-trades",
      "label": "Local services and trades",
      "outcome": "Completed, paid, profitable jobs; qualified inquiries and bookings are leading indicators, not completed jobs",
      "journey": "Discovery → call/form → qualification → estimate → scheduled job → completion/payment → maintenance/referral",
      "capacity": "Response time, seasonality, crew hours, dispatch and service area",
      "buyer_distinction": "Qualified inquiry-to-job, show/completion rate, contribution/job, repeat work. Caller, property owner and payer may differ"
    },
    {
      "id": "ecommerce",
      "label": "Ecommerce and physical products",
      "outcome": "Paid/fulfilled eligible units or orders, net of defined returns/cancellations; do not equate units with customers",
      "journey": "Discovery → product → cart → checkout/payment → shipment → use → return or reorder",
      "capacity": "Inventory, shipping, stockouts, replenishment and seasonality",
      "buyer_distinction": "Contribution/order, conversion, AOV, returns, repeat purchase. Purchaser may be buying a gift or for another user"
    },
    {
      "id": "saas",
      "label": "SaaS and subscriptions",
      "outcome": "Activated, retained paying accounts or appropriately defined recurring revenue; trial/sign-up is not activation/payment",
      "journey": "Discovery → trial/demo → setup → first value → payment → sustained use → renewal/expansion/churn",
      "capacity": "Onboarding time, renewal cohorts, support/service costs",
      "buyer_distinction": "Activation, trial-to-paid, retention/churn, contribution and payback. Champion, admin, user, budget owner and buyer can differ"
    },
    {
      "id": "retail-hospitality",
      "label": "Local retail and hospitality",
      "outcome": "Completed profitable transactions, visits, reservations or stays; specify the unit",
      "journey": "Discovery → reservation or walk-in → visit/service → payment → review/revisit",
      "capacity": "Opening hours, seats/rooms, staffing, local seasons and no-shows",
      "buyer_distinction": "Booking-to-visit, utilization, spend/visit, contribution, repeat rate. Booker, guest and payer may differ"
    },
    {
      "id": "rentals-events",
      "label": "Rentals and events",
      "outcome": "Completed, paid rentals/events with defined deposit, cancellation and refund treatment",
      "journey": "Inquiry → date/availability → quote → deposit → logistics/setup → event → return/settlement → repeat/referral",
      "capacity": "Date-specific inventory, delivery routes, setup crew, damage and return timing",
      "buyer_distinction": "Quote-to-book, utilization, contribution/event, cancellations, delivery reliability. Planner, end client, venue and payer may differ"
    },
    {
      "id": "professional-practices",
      "label": "Professional practices",
      "outcome": "Suitable completed and paid engagements/appointments under the practice’s own permitted criteria; inquiry is not accepted service",
      "journey": "Discovery/referral → permissioned intake → suitability/scheduling → appointment/engagement → service → payment/follow-up",
      "capacity": "Practitioner capacity, appointment cycles, confidentiality and professional obligations",
      "buyer_distinction": "Qualified-intake conversion, attendance, capacity and collection where appropriate. Client/patient, referrer, decision-maker and payer can differ; no automated sensitive eligibility judgments"
    },
    {
      "id": "b2b-services",
      "label": "B2B agencies and consulting",
      "outcome": "Signed, delivered and paid engagements or retained accounts, with each stage separately recorded",
      "journey": "Introduction/inbound → discovery → qualification → proposal → procurement → signed engagement → delivery → invoice/payment → expansion",
      "capacity": "Longer buying cycles, procurement, billable capacity and scope control",
      "buyer_distinction": "Stage conversion, sales cycle, delivery margin, retention, receivables. Champion, economic buyer, procurement and users differ"
    }
  ],
