# Copy to .env.local and fill in. Never commit .env.local.
#
# Every value below is a placeholder. Do not paste real project refs, hostnames,
# or IPs into this file — it is committed to a public repository.

# Supabase — find these under Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pipedream Connect — https://pipedream.com/@/projects
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=proj_YOUR_PROJECT_ID
PIPEDREAM_ENVIRONMENT=development

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future: Agent
# Use a hostname behind TLS, not a bare IP over plain HTTP.
KAI_AGENT_URL=https://agent.example.internal

# AI Chat (Vercel AI SDK)
ANTHROPIC_API_KEY=

# Gateway
GATEWAY_URL=https://gateway.example.internal
GATEWAY_API_KEY=

# Outstand social publishing (server-side only)
OUTSTAND_API_KEY=
OUTSTAND_ORG_ID=

# Long-running agent heartbeat authentication
AGENT_HEARTBEAT_TOKEN=
