#!/usr/bin/env bash
# kai-voice-gate — LLM-as-judge voice-consistency check on any draft.
# Usage: kai-voice-gate <draft-path> [--voice-guide <path>] [--persona <path>]
#                     [--output <path>] [--model <model>] [--max-issues <n>]
#                     [--quiet]
#
# Defaults:
#   --voice-guide   Auto-detected from sibling personas/*-writing-guide.md
#   --output        <draft-stem>.VOICE-GATE.md next to the draft
#   --model         claude-sonnet-4-5  (aliases: haiku | sonnet | opus)
#   --max-issues    30
#
# Env:
#   ANTHROPIC_API_KEY   required. Errors clearly if missing.
#
# Exits 1 on FAIL verdict, 0 on PASS/HOLD. Prints a summary JSON on stdout.
set -euo pipefail

KAI_ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
export PYTHONPATH="${KAI_ROOT}:${PYTHONPATH:-}"

source "${KAI_ROOT}/lib/find-python.sh"
exec "$PYTHON" -m scripts.voice_gate.runner "$@"
